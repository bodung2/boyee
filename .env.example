# 이 파일을 .env로 복사해서 값을 채우세요. (.env는 git에 올라가지 않습니다)

# 네이버 블로그 아이디 (blog.naver.com/여기부분)
NAVER_BLOG_ID=

# 발행할 카테고리 이름(블로그에 보이는 이름 그대로). 비우면 기본 카테고리.
NAVER_CATEGORY_CHILDHOOD=
NAVER_CATEGORY_EDU=

# ChatGPT(OpenAI API) — 본문 일러스트 생성 + 교차 팩트체크에 필요
# platform.openai.com 에서 API 키 발급·결제수단 등록(ChatGPT Plus 구독과 별도 과금)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# 16:9 가로형. 모델이 이 크기를 거부하면 자동으로 1536x1024로 다시 시도합니다.
OPENAI_IMAGE_SIZE=1536x864
# low / medium / high (높을수록 비쌈)
OPENAI_IMAGE_QUALITY=medium
OPENAI_FACTCHECK_MODEL=gpt-5.5
GPT_FACTCHECK=true
# 본문 일러스트 개수(유아 글)
ILLUSTRATION_COUNT=2

# 브라우저: chrome(설치된 크롬, 권장) / msedge / 비우면 Playwright 내장 Chromium
BROWSER_CHANNEL=chrome
# 창을 띄우지 않고 실행할지. 네이버 차단을 피하려면 false 권장.
HEADLESS=false

# Claude Code 명령 이름/경로, 사용할 모델(비우면 Claude Code 기본값)
CLAUDE_BIN=claude
CLAUDE_MODEL=
GENERATE_TIMEOUT_SEC=3600
# 글이 검증·팩트체크에서 떨어졌을 때 새로 쓰는 최대 횟수
MAX_ATTEMPTS=2

# (선택) 텔레그램 알림: 발행 완료/실패를 휴대폰으로 받기
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
