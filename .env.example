# 이 파일을 .env로 복사해서 값을 채우세요. (.env는 git에 올라가지 않습니다)

# 네이버 블로그 아이디 (blog.naver.com/여기부분)
# 유아 블로그(기본)와 교육 블로그가 다른 계정이면 각각 적습니다. 자동화용 크롬도 계정별로 따로 씁니다.
NAVER_BLOG_ID=
NAVER_BLOG_ID_EDU=

# 발행할 카테고리 이름(블로그에 보이는 이름 그대로). 비우면 기본 카테고리.
NAVER_CATEGORY_CHILDHOOD=
# 교육 블로그는 글 종류(레인)로 자동 분류: 교직 실무(B) → '교직 꿀팁', 나머지 → '교육 정책 인사이트'
# 블로그의 카테고리 이름이 다르면 아래에 실제 이름을 적으세요(비우면 위 기본 이름).
NAVER_CATEGORY_EDU_B=
NAVER_CATEGORY_EDU=

# ── 본문 일러스트 ─────────────────────────────────────────────
# codex(기본): Codex CLI 내장 이미지 생성 — ChatGPT 구독 로그인으로 동작(API 결제 없음, 구독 사용량 사용)
# gemini: Gemini API(나노바나나, 결제 등록 필요) / openai: OpenAI API(유료)
IMAGE_BACKEND=codex
ILLUSTRATION_COUNT=2
CODEX_IMAGE_TIMEOUT_SEC=360
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── 한 줄 요약 앞 핵심 인포그래픽(Codex onepage 스킬, ChatGPT 구독) ──
# INFOGRAPHIC_SKILL은 Codex에 설치된 스킬 이름(폴더 이름)입니다. 끄려면 INFOGRAPHIC=false
INFOGRAPHIC=true
INFOGRAPHIC_SKILL=onepage
INFOGRAPHIC_TIMEOUT_SEC=900

# ── 인스타그램·쓰레드 자동 발행(Meta 공식 API) ── 발급 방법: docs/SOCIAL_SETUP.md
# 블로그 발행 직후 초안(output/<프로필>/<날짜>/social.json)을 만들고, 저녁 예약 작업이 발행합니다.
# 계정은 블로그마다 따로: _EDU(교육 블로그용 계정), _CHILDHOOD(유아 블로그용 계정). 비워 두면 그 채널은 올리지 않습니다.
SOCIAL_DRAFT=true
THREADS_ACCESS_TOKEN_EDU=
INSTAGRAM_ACCESS_TOKEN_EDU=
THREADS_ACCESS_TOKEN_CHILDHOOD=
INSTAGRAM_ACCESS_TOKEN_CHILDHOOD=
# 인포그래픽을 Meta가 가져갈 수 있게 잠시 올려 둘 곳(https://api.imgbb.com 무료 키, 하루 뒤 자동 삭제)
IMGBB_API_KEY=
# 쓰레드 글에도 인포그래픽을 붙일지
THREADS_WITH_IMAGE=true

# ── ChatGPT 교차 팩트체크 ─────────────────────────────────────
# codex(기본): Codex CLI에 "Sign in with ChatGPT"로 로그인 → API 결제 없이 ChatGPT 구독으로 동작
# api: OpenAI API 키로 동작(유료)
FACTCHECK_BACKEND=codex
GPT_FACTCHECK=true
CODEX_BIN=codex
# 비워 두면 웹 검색 옵션을 자동으로 찾습니다. 직접 지정 예: exec --search
CODEX_ARGS=
CODEX_MODEL=
CODEX_TIMEOUT_SEC=1200
# (선택) Codex가 안 될 때만 쓰는 예비 경로. 비워 두면 Codex가 안 되는 날은 발행을 멈추고 알립니다.
OPENAI_API_KEY=
OPENAI_FACTCHECK_MODEL=gpt-5.5

# 브라우저: chrome(설치된 크롬, 권장) / msedge / 비우면 Playwright 내장 Chromium
BROWSER_CHANNEL=chrome
# 창을 띄우지 않고 실행할지. 네이버 차단을 피하려면 false 권장.
HEADLESS=false

# Claude Code 명령 이름/경로, 사용할 모델(비우면 Claude Code 기본값)
CLAUDE_BIN=claude
CLAUDE_MODEL=
GENERATE_TIMEOUT_SEC=3600
# Claude 구독 사용 한도에 걸리면 풀릴 때까지 기다렸다가 이어서 한다(최대 대기 분)
CLAUDE_LIMIT_WAIT_MAX_MIN=330
# 글이 검증·팩트체크에서 떨어졌을 때 새로 쓰는 최대 횟수
MAX_ATTEMPTS=2

# (선택) 텔레그램 알림: 발행 완료/실패를 휴대폰으로 받기
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
