# 이 파일을 .env로 복사해서 값을 채우세요. (.env는 git에 올라가지 않습니다)

# 네이버 블로그 아이디 (blog.naver.com/여기부분)
# 유아 블로그(기본)와 교육 블로그가 다른 계정이면 각각 적습니다. 자동화용 크롬도 계정별로 따로 씁니다.
NAVER_BLOG_ID=
NAVER_BLOG_ID_EDU=

# 발행할 카테고리 이름(블로그에 보이는 이름 그대로). 비우면 기본 카테고리.
NAVER_CATEGORY_CHILDHOOD=
# 교육 블로그는 글 종류(레인)로 자동 분류: 교직 실무(B) → '교직 꿀팁', 나머지 → '교육 정책 인사이트'
# 블로그의 카테고리 이름이 다르면 아래에 실제 이름을 적으세요(비우면 위 기본 이름).
NAVER_CATEGORY_EDU_B=
NAVER_CATEGORY_EDU=

# ── 본문 일러스트 ─────────────────────────────────────────────
# codex(기본): Codex CLI 내장 이미지 생성 — ChatGPT 구독 로그인으로 동작(API 결제 없음, 구독 사용량 사용)
# gemini: Gemini API(나노바나나, 결제 등록 필요) / openai: OpenAI API(유료)
IMAGE_BACKEND=codex
ILLUSTRATION_COUNT=2
CODEX_IMAGE_TIMEOUT_SEC=360
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── 한 줄 요약 앞 핵심 인포그래픽(Codex onepage 스킬, ChatGPT 구독) ──
# INFOGRAPHIC_SKILL은 Codex에 설치된 스킬 이름(폴더 이름)입니다. 끄려면 INFOGRAPHIC=false
INFOGRAPHIC=true
INFOGRAPHIC_SKILL=onepage
INFOGRAPHIC_TIMEOUT_SEC=900

# ── ChatGPT 교차 팩트체크 ─────────────────────────────────────
# codex(기본): Codex CLI에 "Sign in with ChatGPT"로 로그인 → API 결제 없이 ChatGPT 구독으로 동작
# api: OpenAI API 키로 동작(유료)
FACTCHECK_BACKEND=codex
GPT_FACTCHECK=true
CODEX_BIN=codex
# 비워 두면 웹 검색 옵션을 자동으로 찾습니다. 직접 지정 예: exec --search
CODEX_ARGS=
CODEX_MODEL=
CODEX_TIMEOUT_SEC=1200
# (선택) Codex가 안 될 때만 쓰는 예비 경로. 비워 두면 Codex가 안 되는 날은 발행을 멈추고 알립니다.
OPENAI_API_KEY=
OPENAI_FACTCHECK_MODEL=gpt-5.5

# 브라우저: chrome(설치된 크롬, 권장) / msedge / 비우면 Playwright 내장 Chromium
BROWSER_CHANNEL=chrome
# 창을 띄우지 않고 실행할지. 네이버 차단을 피하려면 false 권장.
HEADLESS=false

# Claude Code 명령 이름/경로, 사용할 모델(비우면 Claude Code 기본값)
CLAUDE_BIN=claude
CLAUDE_MODEL=
GENERATE_TIMEOUT_SEC=3600
# Claude 구독 사용 한도에 걸리면 풀릴 때까지 기다렸다가 이어서 한다(최대 대기 분)
CLAUDE_LIMIT_WAIT_MAX_MIN=330
# 글이 검증·팩트체크에서 떨어졌을 때 새로 쓰는 최대 횟수
MAX_ATTEMPTS=2

# (선택) 텔레그램 알림: 발행 완료/실패를 휴대폰으로 받기
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 구글 블로거 자동 발행 (python -m blogger_autopost) ──────────
# 블로그 주소(예: https://myblog.blogspot.com). 비우면 계정의 블로그가 하나일 때 그것을 쓴다.
BLOGGER_BLOG_URL=
BLOGGER_BLOG_ID=
# 글을 쓰는 Codex 스킬 이름(~/.codex/skills 아래 폴더 이름). 못 찾으면 SKILL.md 경로를 직접 적는다.
BLOGGER_SKILL=korea-explained-blogger
BLOGGER_SKILL_PATH=
# 공개 시각(한국 시각 HH:MM). 비우면 글이 완성되는 즉시 발행, 적으면 그 시각으로 예약 발행
BLOGGER_PUBLISH_TIME=
# 별도 Codex 세션의 웹 검색 팩트체크(끄려면 false), 지적 반영 횟수, 다른 주제로 다시 쓰는 최대 횟수
BLOGGER_FACTCHECK=true
BLOGGER_FIX_ROUNDS=2
BLOGGER_MAX_ATTEMPTS=2
BLOGGER_MIN_SOURCES=3
BLOGGER_MIN_BODY_CHARS=2000
BLOGGER_WRITE_TIMEOUT_SEC=3600
# 블로거 글을 쓰는 Codex 모델과 추론 단계(ChatGPT 화면의 'Light' = low).
# ChatGPT 로그인으로 Sol을 쓸 수 없는 요금제면 자동으로 FALLBACK 모델로 바꿔 쓰고 알림에 적는다.
BLOGGER_CODEX_MODEL=gpt-5.6-sol
BLOGGER_CODEX_EFFORT=low
BLOGGER_CODEX_FALLBACK_MODEL=gpt-5.6-terra
# 위키미디어 커먼즈 사진: 글마다 최대 장수(0이면 사진 없음), 자리마다 AI가 비교해 볼 후보 수
BLOGGER_PHOTOS=3
BLOGGER_PHOTO_CANDIDATES=4

# ── 티스토리 '논쟁 × 공식 통계' 자동 발행 (python -m tistory_autopost) ──
# 블로그 주소 또는 이름(예: https://eskimo-igloo.tistory.com 또는 eskimo-igloo)
TISTORY_BLOG=
# 발행할 카테고리 이름(블로그에 보이는 이름 그대로). 비우면 카테고리 없이 발행
TISTORY_CATEGORY=
# 텔레그램으로 "화제 금수저 논쟁 또 터짐"처럼 보내면 다음 글 주제로 우선 검토한다(머리말)
TISTORY_TIP_PREFIX=화제
# ChatGPT(Codex) 교차 팩트체크(끄려면 false), 다시 쓰는 최대 횟수, 발행 기준
TISTORY_GPT_FACTCHECK=true
TISTORY_MAX_ATTEMPTS=2
TISTORY_MIN_SOURCES=4
TISTORY_MIN_PRIMARY_SOURCES=2
TISTORY_MIN_DATA_POINTS=6
TISTORY_MIN_BODY_CHARS=1800
